<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Health Mirror</title>
<style>
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  font-family: Arial, sans-serif;
  color: #183c4a;
  background: linear-gradient(135deg,#effbf8,#eef5ff);
}
a {
  text-decoration: none;
  color: inherit;
}
button {
  cursor: pointer;
  font: inherit;
}
.navbar {
  width: 94%;
  margin: 18px auto;
  padding: 13px 20px;
  background: white;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  box-shadow: 0 8px 30px #315c6810;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: bold;
  font-size: 20px;
}
.brand img {
  width: 48px;
  height: 48px;
  object-fit: contain;
}
.brand small {
  display: block;
  color: #159f9b;
  font-size: 9px;
  letter-spacing: 1px;
}
.navlinks {
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  align-items: center;
  font-size: 13px;
  color: #526c77;
}
.menu-btn {
  display: none;
  border: 0;
  background: #eaf9f5;
  padding: 9px 13px;
  border-radius: 10px;
}
.hero {
  max-width: 1120px;
  margin: 65px auto 55px;
  padding: 25px;
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  align-items: center;
  gap: 35px;
}
.eyebrow {
  color: #159f9b;
  font-weight: bold;
  letter-spacing: 2px;
  font-size: 12px;
}
.hero h1 {
  font-size: clamp(42px,6vw,68px);
  margin: 15px 0;
}
.gradient-text {
  background: linear-gradient(90deg,#159f9b,#4c91d9,#8871d9);
  -webkit-background-clip: text;
  color: transparent;
}
.hero p {
  color: #66818a;
  line-height: 1.8;
  max-width: 540px;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 25px;
}
.btn {
  display: inline-block;
  padding: 13px 21px;
  border-radius: 13px;
  border: 0;
  font-weight: bold;
}
.primary {
  color: white;
  background: linear-gradient(100deg,#159f9b,#4c91d9);
}
.secondary {
  background: white;
  color: #159f9b;
  border: 1px solid #ccebe5;
}
.hero-art {
  min-height: 330px;
  border-radius: 35px;
  background: linear-gradient(145deg,#d9f7ed,#e3eaff);
  display: grid;
  place-items: center;
  position: relative;
}
.mirror {
  width: 190px;
  height: 235px;
  border: 9px solid white;
  border-radius: 100px 100px 45px 45px;
  background: linear-gradient(145deg,#a9e9dc,#9db9f0);
  display: grid;
  place-items: center;
  font-size: 75px;
}
.art-label {
  position: absolute;
  bottom: 22px;
  background: white;
  color: #159f9b;
  padding: 10px 16px;
  border-radius: 30px;
  font-size: 12px;
  font-weight: bold;
}
.sources {
  text-align: center;
  color: #66818a;
  font-size: 13px;
  margin: 15px;
}
.sources strong {
  color: #159f9b;
  margin: 0 9px;
}
.section {
  max-width: 1120px;
  margin: 65px auto;
  padding: 20px;
}
.section-title {
  text-align: center;
  margin-bottom: 30px;
}
.section-title h2 {
  font-size: 32px;
}
.section-title p {
  color: #66818a;
}
.cards {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 17px;
}
.card {
  background: white;
  border: 1px solid #e4f1ef;
  border-radius: 20px;
  padding: 23px;
}
.card .symbol {
  font-size: 30px;
}
.card h3 {
  font-size: 17px;
}
.card p {
  color: #66818a;
  line-height: 1.6;
  font-size: 14px;
}
.panel-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 18px;
}
.panel {
  background: white;
  padding: 25px;
  border-radius: 22px;
  border: 1px solid #e0efed;
}
.panel h3 {
  color: #159f9b;
}
.panel p {
  color: #66818a;
  line-height: 1.7;
}
footer {
  text-align: center;
  padding: 30px;
  color: #66818a;
  font-size: 13px;
}
@media(max-width:800px) {
  .hero {
    grid-template-columns: 1fr;
    margin-top: 30px;
  }
  .cards {
    grid-template-columns: repeat(2,1fr);
  }
  .panel-grid {
    grid-template-columns: 1fr;
  }
  .navlinks {
    display: none;
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
  }
  .navlinks.open {
    display: flex;
  }
  .navbar {
    flex-wrap: wrap;
  }
  .menu-btn {
    display: block;
  }
}
@media(max-width:430px) {
  .cards {
    grid-template-columns: 1fr;
  }
}
</style>
</head>
<body>

<header class="navbar">
  <a class="brand" href="#home">
    <img src="logo.png" alt="Health Mirror logo">
    <span>
      Health Mirror
      <small>FACTS REFLECT BETTER HEALTH</small>
    </span>
  </a>
  <button class="menu-btn" onclick="toggleMenu()">☰</button>
  <nav class="navlinks" id="navlinks">
    <a href="#home">Home</a>
    <a href="#check">Check a Claim</a>
    <a href="#evidence">Evidence</a>
    <a href="#history">History</a>
    <a href="#alerts">Alerts</a>
    <a href="#community">Community</a>
    <a href="#shield">Share Shield</a>
    <a href="#profile">Profile</a>
    <a href="quiz.html">Quiz</a>
  </nav>
</header>

<main>
<section class="hero" id="home">
  <div>
    <div class="eyebrow">YOUR HEALTH. YOUR KNOWLEDGE. YOUR CHOICE.</div>
    <h1>Health <span class="gradient-text">Mirror</span></h1>
    <p>
      Reflect before you believe. Explore health claims,
      learn from trusted medical sources, and make safer
      health decisions.
    </p>
    <div class="actions">
      <a class="btn primary" href="#check">Check a Claim</a>
      <a class="btn secondary" href="#features">Learn More</a>
    </div>
  </div>
  <div class="hero-art">
    <div class="mirror">🛡️</div>
    <div class="art-label">Reflect • Verify • Protect</div>
  </div>
</section>

<div class="sources">
  Supported by trusted knowledge:
  <strong>WHO</strong>
  <strong>PubMed</strong>
  <strong>NIH</strong>
</div>

<section class="section" id="features">
  <div class="section-title">
    <h2>Why Health Mirror?</h2>
    <p>Tools that help you think critically about health information.</p>
  </div>
  <div class="cards">
    <article class="card">
      <div class="symbol">🔎</div>
      <h3>Detect Misinformation</h3>
      <p>Examine health claims and identify warning signs.</p>
    </article>
    <article class="card">
      <div class="symbol">📚</div>
      <h3>Trusted Sources</h3>
      <p>Explore reliable medical and scientific resources.</p>
    </article>
    <article class="card">
      <div class="symbol">🛡️</div>
      <h3>Make Safer Choices</h3>
      <p>Think carefully before sharing health advice.</p>
    </article>
    <article class="card">
      <div class="symbol">⚡</div>
      <h3>Fast & Easy</h3>
      <p>Access useful health information in a simple way.</p>
    </article>
  </div>
</section>
<section class="section" id="check">
  <div class="section-title">
    <h2>Check a Health Claim</h2>
    <p>Pause, reflect, and examine health information.</p>
  </div>

  <div class="panel">
    <label for="claimInput"><strong>Enter a health claim:</strong></label>
    <textarea id="claimInput" rows="5"
      style="width:100%;padding:15px;margin-top:12px;border:1px solid #cce5e2;border-radius:12px;"
      placeholder="Write or paste a health claim here..."></textarea>
    <button class="btn primary" onclick="analyzeClaim()" style="margin-top:12px;">
      Analyze Claim
    </button>
    <div id="claimResult" style="margin-top:20px;"></div>
    <p style="font-size:12px;color:#66818a;">
      This prototype does not provide medical diagnosis or verified AI analysis.
    </p>
  </div>
</section>

<section class="section" id="evidence">
  <div class="section-title">
    <h2>Trusted Evidence</h2>
    <p>Explore reliable health and scientific resources.</p>
  </div>
  <div class="panel-grid">
    <div class="panel">
      <h3>World Health Organization</h3>
      <p>International health information and guidance.</p>
      <a class="btn secondary" href="https://www.who.int/" target="_blank">Visit WHO</a>
    </div>
    <div class="panel">
      <h3>PubMed</h3>
      <p>Search biomedical research and scientific publications.</p>
      <a class="btn secondary" href="https://pubmed.ncbi.nlm.nih.gov/" target="_blank">Visit PubMed</a>
    </div>
    <div class="panel">
      <h3>National Institutes of Health</h3>
      <p>Explore health information and medical research.</p>
      <a class="btn secondary" href="https://www.nih.gov/" target="_blank">Visit NIH</a>
    </div>
  </div>
</section>

<section class="section" id="history">
  <div class="section-title">
    <h2>Analysis History</h2>
    <p>Your recent activity on this device.</p>
  </div>
  <div class="panel">
    <div id="historyList">No claims checked yet.</div>
    <button class="btn secondary" onclick="clearHistory()">Clear History</button>
  </div>
</section>

<section class="section" id="alerts">
  <div class="section-title">
    <h2>Health Alerts</h2>
    <p>Learn how to stay informed about health news.</p>
  </div>
  <div class="panel">
    <h3>Stay Informed</h3>
    <p>Follow official health organizations and check the date and source of health announcements.</p>
    <a class="btn primary" href="https://www.who.int/news" target="_blank">WHO News</a>
    <p style="font-size:12px;">Live alerts are not connected in this prototype.</p>
  </div>
</section>

<section class="section" id="community">
  <div class="section-title">
    <h2>Community</h2>
    <p>Share ideas and encourage responsible health discussions.</p>
  </div>
  <div class="panel">
    <textarea id="communityInput" rows="3"
      style="width:100%;padding:14px;border:1px solid #cce5e2;border-radius:12px;"
      placeholder="Share a health awareness message..."></textarea>
    <button class="btn primary" onclick="addPost()" style="margin-top:12px;">Share Message</button>
    <div id="communityPosts" style="margin-top:20px;"></div>
    <p style="font-size:12px;">Messages are saved locally on this device, not shared with other users.</p>
  </div>
</section>

<section class="section" id="shield">
  <div class="section-title">
    <h2>Share Shield</h2>
    <p>Think before you share health information.</p>
  </div>
  <div class="panel">
    <h3>Before Sharing, Ask Yourself:</h3>
    <p>✓ Is the original source trustworthy?</p>
    <p>✓ Is there scientific evidence?</p>
    <p>✓ Is the information recent?</p>
    <p>✓ Could sharing this claim cause harm?</p>
    <p><strong>Stop. Check. Protect.</strong></p>
  </div>
</section>

<section class="section" id="profile">
  <div class="section-title">
    <h2>Your Profile</h2>
    <p>Personalize your Health Mirror experience.</p>
  </div>
  <div class="panel">
    <label for="userName">Your display name:</label>
    <input id="userName" type="text" placeholder="Enter your name"
      style="width:100%;padding:13px;margin:12px 0;border:1px solid #cce5e2;border-radius:12px;">
    <button class="btn primary" onclick="saveProfile()">Save Profile</button>
    <p id="profileMessage"></p>
  </div>
</section>

<section class="section">
  <div class="section-title">
    <h2>Level Up Your Knowledge!</h2>
    <p>Test what you have learned about health misinformation.</p>
  </div>
  <div class="panel" style="text-align:center;">
    <h3>Health Mirror Quiz</h3>
    <p>Challenge yourself, learn, and earn medals.</p>
    <a class="btn primary" href="quiz.html">Play the Quiz</a>
  </div>
</section>

</main>

<footer>
  <strong>Health Mirror</strong>
  <p>FACTS REFLECT BETTER HEALTH</p>
  <p>Reflect • Verify • Protect</p>
  <p>© 2026 Health Mirror Project</p>
</footer>

<script>
function toggleMenu() {
  document.getElementById("navlinks").classList.toggle("open");
}

function analyzeClaim() {
  const input = document.getElementById("claimInput");
  const result = document.getElementById("claimResult");
  const claim = input.value.trim();

  if (!claim) {
    result.textContent = "Please enter a health claim first.";
    return;
  }

  result.innerHTML =
    "<div class='panel'><h3>Claim Received</h3>" +
    "<p>Your claim has been saved for review.</p>" +
    "<p>Please consult trusted medical sources before accepting or sharing it.</p></div>";

  const history = JSON.parse(localStorage.getItem("hmHistory") || "[]");
  history.unshift(claim);
  localStorage.setItem("hmHistory", JSON.stringify(history.slice(0,10)));
  showHistory();
}

function showHistory() {
  const history = JSON.parse(localStorage.getItem("hmHistory") || "[]");
  const list = document.getElementById("historyList");

  list.innerHTML = history.length
    ? history.map(item => "<p></p>").join("")
    : "No claims checked yet.";

  if (history.length) {
    list.innerHTML = "";
    history.forEach(item => {
      const p = document.createElement("p");
      p.textContent = item;
      list.appendChild(p);
    });
  }
}

function clearHistory() {
  localStorage.removeItem("hmHistory");
  showHistory();
}

function addPost() {
  const input = document.getElementById("communityInput");
  const message = input.value.trim();

  if (!message) {
    alert("Please write a message first.");
    return;
  }

  const posts = JSON.parse(localStorage.getItem("hmPosts") || "[]");
  posts.unshift(message);
  localStorage.setItem("hmPosts", JSON.stringify(posts));
  input.value = "";
  showPosts();
}

function showPosts() {
  const posts = JSON.parse(localStorage.getItem("hmPosts") || "[]");
  const container = document.getElementById("communityPosts");
  container.innerHTML = "";

  posts.forEach(message => {
    const p = document.createElement("p");
    p.textContent = message;
    p.style.padding = "12px";
    p.style.background = "#eaf9f5";
    p.style.borderRadius = "12px";
    container.appendChild(p);
  });
}

function saveProfile() {
  const name = document.getElementById("userName").value.trim();

  if (!name) {
    document.getElementById("profileMessage").textContent =
      "Please enter a name.";
    return;
  }

  localStorage.setItem("hmUserName", name);
  document.getElementById("profileMessage").textContent =
    "Profile saved successfully!";
}

window.addEventListener("DOMContentLoaded", () => {
  showHistory();
  showPosts();
  document.getElementById("userName").value =
    localStorage.getItem("hmUserName") || "";
});
</script>

</body>
</html>
