<!DOCTYPE html>
<html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#effaf7">
<meta name="description" content="Health Mirror — a 100-question health information literacy journey.">
<title>Health Mirror | 25-Round Quiz Journey</title>
<style>
:root{--mint:#eaf8f3;--teal:#087f78;--deep:#145c62;--purple:#7662c8;--ink:#18383b;--muted:#668184;--line:#dcece7;--shadow:0 12px 34px #195b5317}
*{box-sizing:border-box}body{margin:0;background:linear-gradient(145deg,#effaf7,#f7f5ff);font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);min-height:100vh}button{font:inherit;cursor:pointer}a{color:#087f78}.app{max-width:1000px;margin:auto;padding:22px 16px 40px}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;gap:10px}.brand{display:flex;align-items:center;gap:10px;font-weight:900}.logo{width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,#10a99a,#7d6bd0);display:grid;place-items:center;color:white;font-size:23px}.brand small{display:block;color:var(--muted);font-size:10px;letter-spacing:1.5px}.sound,.secondary{border:1px solid var(--line);background:#fff;border-radius:999px;padding:10px 14px;color:var(--deep);font-weight:750}.screen{display:none}.screen.active{display:block}.panel{background:#ffffffed;border:1px solid #e1eee9;border-radius:24px;box-shadow:var(--shadow);padding:clamp(18px,4vw,34px)}.hero{text-align:center;padding:32px 18px}.eyebrow{color:var(--teal);font-size:12px;font-weight:850;letter-spacing:2px;text-transform:uppercase}.hero h1{font-size:clamp(30px,5vw,46px);line-height:1.1;margin:12px 0;color:#174f53}.hero p{color:var(--muted);max-width:640px;margin:0 auto 20px;line-height:1.7}.hero-icon{font-size:54px;margin:12px}.primary{border:0;border-radius:14px;padding:14px 22px;background:linear-gradient(110deg,#07988c,#7163c9);color:#fff;font-weight:850;box-shadow:0 8px 20px #287f7940}.stats{display:flex;justify-content:center;gap:9px;flex-wrap:wrap;margin:20px}.pill,.tag{background:#edf7f4;color:#39716b;border-radius:999px;padding:7px 11px;font-size:12px;font-weight:800}.rankgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:24px}.rank{border:1px solid var(--line);border-radius:14px;padding:10px 4px;background:#fbfefd;font-size:12px;font-weight:800}.rank span{display:block;font-size:22px}.journey{margin-top:18px}.roundmap{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.rounddot{border:1px solid var(--line);background:#f8fbfa;border-radius:10px;padding:9px 3px;text-align:center;color:#9aadae;font-size:11px;font-weight:800}.rounddot.done{background:#e2f7ee;border-color:#a9dfc8;color:#147557}.rounddot.current{background:#e9e8ff;border-color:#b9b2f2;color:#5142a5}.collection{display:grid;grid-template-columns:repeat(auto-fit,minmax(125px,1fr));gap:8px}.badge{display:flex;align-items:center;gap:8px;padding:9px;border:1px solid var(--line);border-radius:13px;background:#fff;font-size:12px}.badge b{display:block}.badge small{display:block;color:var(--muted);font-size:10px}.quizhead,.actions{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}.quizhead strong{color:var(--teal)}.muted{color:var(--muted);font-size:13px;font-weight:750}.track{height:9px;background:#e7f0ed;border-radius:99px;overflow:hidden;margin:13px 0 22px}.fill{height:100%;width:0;background:linear-gradient(90deg,#0aa28f,#8170d5);transition:width .2s}.meta{display:flex;gap:7px;flex-wrap:wrap}.question{font-size:clamp(21px,3.5vw,28px);line-height:1.35;margin:13px 0 20px}.options{display:grid;gap:10px}.option{display:flex;align-items:center;gap:12px;text-align:left;border:1.5px solid #dcebe6;border-radius:15px;background:#fff;padding:14px;color:var(--ink);font-weight:650;line-height:1.45}.option:hover:not(:disabled){border-color:#68b9a9;background:#f8fffc}.letter{width:30px;height:30px;flex:0 0 30px;border-radius:9px;background:#edf6f3;color:#36716a;display:grid;place-items:center;font-weight:900}.option.correct{border-color:#66c49a;background:#edfbf3}.option.wrong{border-color:#e6a2a8;background:#fff3f3}.option:disabled{cursor:default}.feedback{display:none;margin-top:17px;border-radius:15px;padding:16px;background:#f0faf5;border:1px solid #d3eee0;line-height:1.6}.feedback.show{display:block}.feedback.bad{background:#fff7f4;border-color:#f1ddd5}.feedback h3{margin:0 0 6px;font-size:16px}.feedback p{margin:0 0 9px;color:#4f696a}.feedback a{font-weight:800;font-size:13px}.actions{margin-top:20px}.hidden{display:none!important}.result{text-align:center}.bigmedal{font-size:72px;margin:12px}.result h2{font-size:clamp(27px,4vw,38px);margin:8px}.result p{color:var(--muted);line-height:1.6}.resultstats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:22px 0}.resultstat{background:#f3faf7;border-radius:15px;padding:14px}.resultstat strong{display:block;font-size:24px;color:#176e68}.resultstat span{font-size:11px;color:var(--muted);font-weight:750}.notice{text-align:center;color:#71898a;font-size:11px;line-height:1.5;margin:20px auto 0;max-width:760px}
@media(max-width:580px){.app{padding:14px 11px 30px}.panel{border-radius:19px;padding:18px 14px}.rankgrid{grid-template-columns:repeat(2,1fr)}.roundmap{gap:4px}.rounddot{font-size:10px;padding:7px 2px}.resultstats{gap:5px}.resultstat{padding:10px 3px}.resultstat strong{font-size:20px}}
</style></head><body><main class="app">
<header class="top"><div class="brand"><div class="logo">◈</div><div>HEALTH MIRROR<small>THINK BEFORE YOU TRUST</small></div></div><button class="sound" id="soundToggle">♫ Sound ON</button></header>
<section class="screen active" id="homeScreen"><div class="panel hero"><div class="hero-icon">🪞</div><div class="eyebrow">Your health literacy journey</div><h1>Think clearly.<br>Check the evidence.</h1><p>Build the skills to recognize health misinformation, evaluate scientific evidence, and share information responsibly.</p><div class="stats"><span class="pill">25 Rounds</span><span class="pill">100 Questions</span><span class="pill">4 Questions per round</span></div><button class="primary" id="begin">Start Round 1 →</button><div class="rankgrid"><div class="rank"><span>🌱</span>Beginner</div><div class="rank"><span>🔎</span>Fact Finder</div><div class="rank"><span>🧠</span>Critical Thinker</div><div class="rank"><span>🛡️</span>Defender</div><div class="rank"><span>👑</span>Health Guardian</div></div></div>
<div class="panel journey"><h3>Your 25-round map</h3><p class="muted" id="journeySummary"></p><div class="roundmap" id="roundMap"></div><h3>Milestone medals</h3><div class="collection" id="milestoneCollection"></div><h3>Round medals</h3><div class="collection" id="badgeCollection"></div><div class="actions"><button class="secondary" id="restart">Reset journey</button><span class="muted" id="homeScore"></span></div></div></section>
<section class="screen" id="quizScreen"><div class="panel"><div class="quizhead"><strong id="roundLabel">ROUND 1 / 25</strong><span class="muted" id="qCount">Question 1 of 4</span></div><div class="track"><div class="fill" id="bar"></div></div><div class="meta"><span class="tag" id="topic"></span><span class="tag" id="difficulty"></span><span class="tag" id="badgeLabel"></span></div><h2 class="question" id="question"></h2><div class="options" id="options"></div><div class="feedback" id="feedback"></div><div class="actions"><span class="muted" id="scoreLabel">0 pts</span><button class="primary hidden" id="next">Next question →</button></div></div></section>
<section class="screen" id="roundResult"><div class="panel result"><div class="eyebrow">Round completed</div><div class="bigmedal" id="resultMedal">🏅</div><h2 id="resultTitle">Excellent progress!</h2><p id="resultText"></p><h3 id="resultBadgePill"></h3><p id="badgeMotivationText"></p><div class="resultstats"><div class="resultstat"><strong id="correctStat">0/4</strong><span>Correct answers</span></div><div class="resultstat"><strong id="pointsStat">0</strong><span>Points earned</span></div><div class="resultstat"><strong id="accuracyStat">0%</strong><span>Accuracy</span></div></div><div id="newBadgeArea"></div><button class="primary" id="continue">Start next round →</button></div></section>
<section class="screen" id="journeyDone"><div class="panel result"><div class="eyebrow">Journey complete</div><div class="bigmedal">👑</div><h2>Health Guardian!</h2><p>You completed all 25 rounds and explored 100 questions about health information literacy.</p><div class="resultstats"><div class="resultstat"><strong>100</strong><span>Questions</span></div><div class="resultstat"><strong>25</strong><span>Rounds</span></div><div class="resultstat"><strong id="totalPoints">0</strong><span>Total points</span></div></div><p>Keep checking sources, questioning bold claims, and sharing responsibly.</p><button class="secondary" id="restartFinal">Play again</button></div></section>
<p class="notice">Educational activity only. This quiz does not provide diagnosis or personal medical advice. For personal health decisions, consult a qualified healthcare professional.</p></main>
<script>
"use strict";
const QUESTIONS=[{"id":1,"q":"What is the best first step when you see a surprising health claim online?","o":["Share it quickly","Check who published it and where the evidence comes from","Trust it if it has many likes"],"a":1,"e":"Popularity is not proof. Start by checking the source and tracing the evidence.","t":"Source checking","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":0},{"id":2,"q":"Which source is generally strongest for current public-health guidance?","o":["An anonymous comment","A celebrity post","A relevant public-health agency"],"a":2,"e":"Public-health agencies publish guidance based on reviewed evidence, although dates and context still matter.","t":"Reliable sources","s":"WHO — Health topics","u":"https://www.who.int/health-topics","d":0},{"id":3,"q":"A post says a remedy works for everyone. What is a warning sign?","o":["An absolute promise with no limits","A link to a study","A clear explanation of uncertainty"],"a":0,"e":"Health effects vary. Claims that promise the same result for everyone deserve careful checking.","t":"Overclaiming","s":"NCCIH — Health information","u":"https://www.nccih.nih.gov/health","d":0},{"id":4,"q":"What does a study's sample size tell you?","o":["Whether the headline is exciting","How many participants or observations were included","Whether the author is famous"],"a":1,"e":"Sample size helps readers judge how much information a study contains; it does not by itself prove quality.","t":"Study basics","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":0},{"id":5,"q":"Why should you check the publication date of health advice?","o":["Older information is always false","Dates never matter","Guidance and evidence can change over time"],"a":2,"e":"Health recommendations can change as new evidence becomes available.","t":"Recency","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":0},{"id":6,"q":"A post cites a scientific paper. What should you check?","o":["Whether the paper actually supports the claim","Only the paper's title","How many times the post was shared"],"a":0,"e":"A citation may be real but misrepresented. Compare the claim with the study's actual findings.","t":"Citations","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":0},{"id":7,"q":"What is misinformation?","o":["Information that is always shared by experts","False or inaccurate information, whether or not the sharer intends harm","Any information you disagree with"],"a":1,"e":"Misinformation is inaccurate information; intent is not required for the term.","t":"Misinformation","s":"WHO — Infodemic","u":"https://www.who.int/news-room/questions-and-answers/item/infodemic","d":0},{"id":8,"q":"What is disinformation?","o":["A harmless typo","A scientific disagreement","False information deliberately created or shared to mislead"],"a":2,"e":"Disinformation involves deliberate deception, unlike misinformation which does not require intent.","t":"Disinformation","s":"WHO — Infodemic","u":"https://www.who.int/news-room/questions-and-answers/item/infodemic","d":0},{"id":9,"q":"A screenshot has no visible source. What can you conclude?","o":["The source and context are not established by the screenshot alone","It must be authentic","It must be fake"],"a":0,"e":"Screenshots can omit dates, authors, and surrounding context. Be clear about what cannot be verified.","t":"Screenshot limits","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":0},{"id":10,"q":"What is a primary source in health research?","o":["A repost of someone else's summary","The original research report or data","A reaction video"],"a":1,"e":"Primary sources report the original study or data rather than only repeating another account.","t":"Research sources","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":0},{"id":11,"q":"Why are systematic reviews useful?","o":["They guarantee every included study is perfect","They replace the need to inspect methods","They bring together research using a structured method"],"a":2,"e":"Systematic reviews synthesize multiple studies, but their conclusions depend on the quality of the evidence.","t":"Evidence synthesis","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":0},{"id":12,"q":"A post says 'doctors don't want you to know this.' What should you notice?","o":["It uses suspicion and secrecy instead of evidence","It proves the claim is correct","It means the information is new"],"a":0,"e":"Conspiracy-style framing is not evidence. Look for verifiable support and credible sources.","t":"Emotional framing","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":0},{"id":13,"q":"What does peer review usually mean?","o":["A guarantee that a study is correct","Other experts evaluate a manuscript before publication","The public votes on the result"],"a":1,"e":"Peer review is a quality-control step, not a guarantee that a study is error-free.","t":"Peer review","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":0},{"id":14,"q":"A single small study reports a surprising result. What is the careful response?","o":["Treat it as settled science","Ignore all research forever","Look for replication and the wider body of evidence"],"a":2,"e":"One study rarely settles a complex question. Check whether findings are replicated and fit other evidence.","t":"Replication","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":0},{"id":15,"q":"What is a conflict of interest?","o":["A factor that could influence someone's judgment or reporting","A spelling mistake","A type of vaccine"],"a":0,"e":"Financial or other interests can potentially influence research or communication and should be disclosed.","t":"Conflicts of interest","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":0},{"id":16,"q":"Why is correlation not enough to prove causation?","o":["Correlations are always fake","Two things can move together without one causing the other","It only applies to social media"],"a":1,"e":"Other factors may explain an association. Stronger designs are needed to assess cause and effect.","t":"Causality","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":0},{"id":17,"q":"A graph has a dramatic visual. What should you inspect?","o":["Only its colors","The account's follower count","The axes, scale, labels, and underlying numbers"],"a":2,"e":"Visual design can exaggerate differences. Read the scale and the actual values.","t":"Chart literacy","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":0},{"id":18,"q":"What is an anecdote?","o":["A personal story or individual experience","A randomized controlled trial","A systematic review"],"a":0,"e":"Personal stories can be meaningful, but they cannot establish how a treatment works for everyone.","t":"Anecdotal evidence","s":"NCCIH — Health information","u":"https://www.nccih.nih.gov/health","d":0},{"id":19,"q":"A post uses a famous person's photo to promote a cure. What matters most?","o":["The person's popularity","Reliable evidence for the specific health claim","The number of comments"],"a":1,"e":"A celebrity endorsement does not demonstrate safety or effectiveness.","t":"Endorsements","s":"NCCIH — Health information","u":"https://www.nccih.nih.gov/health","d":0},{"id":20,"q":"What does 'natural' tell you about a product's safety?","o":["It proves the product is safe","It proves the product is effective","It does not by itself establish safety or effectiveness"],"a":2,"e":"Natural products can still have risks, interactions, or limited evidence.","t":"Supplements","s":"NCCIH — Health information","u":"https://www.nccih.nih.gov/health","d":0},{"id":21,"q":"Why should health claims be checked in context?","o":["The same words can mean different things depending on population, dose, and situation","Context is unnecessary","Context always makes a claim false"],"a":0,"e":"Research findings depend on the people and conditions studied.","t":"Context","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":22,"q":"A headline says a study 'proves' a cure. What should you do?","o":["Trust the headline","Read the study details and see whether the conclusion is justified","Assume every study is misleading"],"a":1,"e":"Headlines can overstate findings. The methods and results provide the needed context.","t":"Headlines","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":1},{"id":23,"q":"What is a placebo?","o":["A guaranteed treatment","A type of public-health agency","A comparison treatment with no active treatment ingredient for the condition being studied"],"a":2,"e":"Placebos can help researchers compare outcomes and account for expectations.","t":"Clinical trials","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":1},{"id":24,"q":"Why do clinical trials have eligibility criteria?","o":["To define who can safely and appropriately participate in the study","To guarantee a positive result","To make every result apply to everyone"],"a":0,"e":"Eligibility criteria define the population studied and affect how broadly findings apply.","t":"Clinical trials","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":1},{"id":25,"q":"What should you do before sharing a dramatic health statistic?","o":["Add more dramatic wording","Find its original source, date, and meaning","Share it without checking"],"a":1,"e":"Statistics need traceable sources and context, including what was measured and when.","t":"Statistics","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":26,"q":"What does an absolute risk describe?","o":["A relative change only","A researcher's opinion","The actual chance or rate of an outcome in a defined group"],"a":2,"e":"Absolute risk helps show the size of an outcome in a group, rather than only a relative change.","t":"Risk statistics","s":"NCCIH — Health information","u":"https://www.nccih.nih.gov/health","d":1},{"id":27,"q":"Why can relative risk reductions sound more impressive than they are?","o":["They may hide the starting risk and the absolute difference","They are always incorrect","They are measured in likes"],"a":0,"e":"A relative percentage needs baseline and absolute-risk context to show practical meaning.","t":"Risk statistics","s":"NCCIH — Health information","u":"https://www.nccih.nih.gov/health","d":1},{"id":28,"q":"A post says a treatment has 'zero risk.' What is the best interpretation?","o":["That must be scientifically proven","Absolute safety claims are rarely justified; check known risks and uncertainty","It means the treatment is natural"],"a":1,"e":"Responsible health communication acknowledges benefits, harms, and uncertainty.","t":"Risk communication","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":29,"q":"What is a false balance in health reporting?","o":["Giving accurate context","Explaining uncertainty","Presenting unequal levels of evidence as if they are equally supported"],"a":2,"e":"Fairness does not mean treating unsupported claims as equal to a strong scientific consensus.","t":"Evidence quality","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":30,"q":"Why is it useful to trace a claim to its original source?","o":["It helps reveal whether later posts changed or distorted the original information","It makes the claim automatically true","It removes the need to read evidence"],"a":0,"e":"Tracing helps identify missing context, altered wording, and unsupported repetitions.","t":"Source tracing","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":31,"q":"A post quotes only one sentence from a long study. What should you check?","o":["Only the quoted sentence","The surrounding text, methods, and full conclusion","Whether the font is professional"],"a":1,"e":"Selective quotation can change meaning. Read the surrounding context before judging.","t":"Context","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":1},{"id":32,"q":"What is the purpose of informed consent in research?","o":["To guarantee the participant benefits","To let researchers hide risks","To help participants understand the study and choose voluntarily"],"a":2,"e":"Informed consent supports an informed, voluntary decision about participation.","t":"Research ethics","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":1},{"id":33,"q":"Why should an AI health checker show its sources?","o":["So users can inspect and verify the evidence themselves","So users never need to think","To make every answer automatically correct"],"a":0,"e":"Transparent sources let users independently evaluate an AI-generated assessment.","t":"AI transparency","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":34,"q":"What is a limitation of automated fact-checking?","o":["It can never process text","It may miss context, nuance, or new evidence and needs human judgment","It always knows the author's intent"],"a":1,"e":"Automated tools can assist but should communicate uncertainty and limitations.","t":"AI limitations","s":"WHO — Infodemic","u":"https://www.who.int/news-room/questions-and-answers/item/infodemic","d":1},{"id":35,"q":"A health claim is unfamiliar and evidence is limited. What is the responsible label?","o":["Definitely true","Definitely false","Insufficient evidence to reach a confident conclusion"],"a":2,"e":"A responsible assessment distinguishes lack of evidence from proof that a claim is false.","t":"Uncertainty","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":36,"q":"What is health literacy?","o":["The ability to find, understand, and use health information and services","Memorizing every medical term","Believing every health message"],"a":0,"e":"Health literacy helps people access, understand, evaluate, and use health information.","t":"Health literacy","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":37,"q":"What is an infodemic?","o":["A single scientific paper","Too much information, including false or misleading information, during an outbreak or health event","A medical diagnosis"],"a":1,"e":"An infodemic makes it harder to find trustworthy guidance when it is needed.","t":"Infodemic","s":"WHO — Infodemic","u":"https://www.who.int/news-room/questions-and-answers/item/infodemic","d":1},{"id":38,"q":"Why can emotionally alarming posts spread quickly?","o":["Emotion makes them scientifically correct","They always come from experts","Strong emotions can encourage rapid reactions and sharing"],"a":2,"e":"Emotional content can spread before people pause to verify it.","t":"Emotional content","s":"WHO — Infodemic","u":"https://www.who.int/news-room/questions-and-answers/item/infodemic","d":1},{"id":39,"q":"What is the best response to a misleading post in a family chat?","o":["Respond respectfully with a clear correction and reliable evidence","Insult the person who shared it","Forward it to more groups"],"a":0,"e":"Respectful correction can keep discussion open and focus attention on evidence.","t":"Corrections","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":40,"q":"Why should you be careful with health advice from influencers?","o":["All influencers are dishonest","Their popularity does not establish medical expertise or evidence","They cannot share useful information"],"a":1,"e":"Evaluate the claim and evidence, not just the creator's reach or confidence.","t":"Influencers","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":41,"q":"What should a trustworthy health explanation include?","o":["Only a confident conclusion","A dramatic warning","Evidence, context, limitations, and uncertainty"],"a":2,"e":"Good explanations show why a conclusion is reached and what remains uncertain.","t":"Communication","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":42,"q":"A website sells the product it recommends. What should you consider?","o":["The commercial interest and whether independent evidence supports the claim","That selling products proves expertise","That all paid content is false"],"a":0,"e":"Commercial interests are relevant context, but the evidence still needs to be assessed.","t":"Commercial bias","s":"NCCIH — Health information","u":"https://www.nccih.nih.gov/health","d":1},{"id":43,"q":"What is the difference between evidence and opinion?","o":["Opinions are always wrong","Evidence can be checked against observations or research; opinion expresses a view","Evidence is whatever gets shared most"],"a":1,"e":"Evidence is open to examination and verification, unlike a personal view alone.","t":"Evidence literacy","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":44,"q":"Why are multiple independent sources useful?","o":["They guarantee certainty","They make the claim popular","They can help confirm whether findings are consistent and independently supported"],"a":2,"e":"Independent evidence is stronger than many sites repeating the same original claim.","t":"Independent sources","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":45,"q":"A health article links to a study but the link is broken. What should you do?","o":["Search for the study title or DOI and verify the reference","Assume the link proves the claim","Ignore the missing link"],"a":0,"e":"A traceable reference allows readers to check what the research actually found.","t":"References","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":1},{"id":46,"q":"What does a control group help researchers do?","o":["Make the study shorter","Compare outcomes with a group that does not receive the intervention being tested","Guarantee the intervention works"],"a":1,"e":"A suitable comparison group helps researchers interpret whether an intervention may have caused a difference.","t":"Study design","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":1},{"id":47,"q":"Why is replication important?","o":["It makes the first study famous","It proves every detail is correct","It tests whether findings can be observed again"],"a":2,"e":"Repeated findings across studies increase confidence, while differences can reveal limitations.","t":"Replication","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":1},{"id":48,"q":"A claim uses a medical term incorrectly. What should a checker do?","o":["Clarify the term and compare the claim with reliable medical definitions","Assume technical words mean the claim is true","Ignore the wording"],"a":0,"e":"Technical language can create an impression of authority without supporting evidence.","t":"Medical language","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":49,"q":"What is a good way to evaluate a health website?","o":["Judge it only by its design","Check authorship, evidence, update date, purpose, and references","Trust it if it has many advertisements"],"a":1,"e":"A polished design is not enough. Check who is responsible and how claims are supported.","t":"Website evaluation","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":50,"q":"What should you do if two reputable sources appear to disagree?","o":["Choose the one with the strongest colors","Assume both are lying","Compare dates, populations, methods, and the exact questions they address"],"a":2,"e":"Differences may reflect timing, populations, or different questions rather than a simple contradiction.","t":"Comparing sources","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":51,"q":"Why is a health claim about 'everyone' often too broad?","o":["Research usually applies to defined groups and conditions, not automatically every person","Everyone has identical health needs","Broad claims need no evidence"],"a":0,"e":"Health evidence has boundaries. Avoid extending findings beyond the populations studied.","t":"Generalization","s":"NCCIH — Clinical studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":1},{"id":52,"q":"What should a responsible checker do when evidence is mixed?","o":["Hide studies that disagree","Explain the mixed findings and why uncertainty remains","Choose whichever result is more exciting"],"a":1,"e":"Mixed evidence should be described fairly rather than simplified into a certain verdict.","t":"Mixed evidence","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":53,"q":"A post says 'clinically tested.' What does that phrase alone prove?","o":["That it works for every person","That regulators endorse it","Very little without details about the test, methods, and results"],"a":2,"e":"Vague phrases such as 'clinically tested' need specific supporting information.","t":"Marketing claims","s":"NCCIH — Health information","u":"https://www.nccih.nih.gov/health","d":1},{"id":54,"q":"Why should a health app protect users' submitted information?","o":["Health information can be sensitive and deserves careful privacy safeguards","Privacy does not matter in education","Public sharing always improves accuracy"],"a":0,"e":"Privacy-conscious design reduces unnecessary exposure of personal information.","t":"Privacy","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":55,"q":"What should an AI tool say when it cannot access a source?","o":["Pretend it read the source","Clearly state that it could not verify the source","Invent a quotation"],"a":1,"e":"A tool should be transparent about what it has and has not checked.","t":"AI honesty","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":56,"q":"Which is the best habit before forwarding health advice?","o":["Forward first and check later","Trust the sender automatically","Pause, check the source, and verify the claim"],"a":2,"e":"A short pause can prevent unverified information from spreading.","t":"Sharing responsibly","s":"WHO — Infodemic","u":"https://www.who.int/news-room/questions-and-answers/item/infodemic","d":1},{"id":57,"q":"What is the safest role for an educational health-information tool?","o":["Help users evaluate information and find reliable sources, not diagnose them","Replace healthcare professionals","Tell users to change treatment"],"a":0,"e":"An educational tool can support health literacy but cannot replace individual clinical care.","t":"Tool boundaries","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":58,"q":"Why should a correction explain the evidence instead of only saying 'false'?","o":["A label alone always teaches enough","An explanation helps readers understand and independently verify the correction","Evidence makes corrections confusing"],"a":1,"e":"Reasoning and sources help people learn how to evaluate similar claims later.","t":"Corrections","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":59,"q":"What is the best response when you are unsure whether a claim is accurate?","o":["Guess based on your first impression","Share it with a warning emoji","Say you are unsure and seek reliable evidence before sharing"],"a":2,"e":"Acknowledging uncertainty is more responsible than presenting a guess as fact.","t":"Uncertainty","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":60,"q":"Why is it important to distinguish a health claim from a personal medical question?","o":["A general fact-check cannot assess an individual's full medical circumstances","They are always identical","A website can safely decide treatment for everyone"],"a":0,"e":"Personal medical decisions require individual context and advice from qualified healthcare professionals.","t":"Medical advice boundaries","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":1},{"id":61,"q":"You see a claim about a new vaccine. Which source path is strongest?","o":["A forwarded voice note","A meme account","Check the relevant public-health agency and the underlying research"],"a":2,"e":"For vaccine claims, consult reliable public-health guidance and examine the evidence behind the specific claim.","t":"Vaccines","s":"WHO — Vaccines and Immunization","u":"https://www.who.int/health-topics/vaccines-and-immunization","d":2},{"id":62,"q":"A relative shares a false health claim. What response is most likely to keep discussion constructive?","o":["Ask where it came from and share a clear, respectful correction","Mock them in the group chat","Send ten unrelated links"],"a":0,"e":"Respectful corrections can keep communication open and focus attention on the evidence.","t":"Communicating corrections","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":63,"q":"A search result is the first item on the page. Does ranking prove reliability?","o":["Yes, first result means most accurate","No, ranking is not a quality guarantee","Only if it has an image"],"a":1,"e":"Search position can reflect many factors and is not a substitute for evaluating source quality.","t":"Search literacy","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":64,"q":"A health claim appears on a government website from eight years ago. What should you do?","o":["Assume it is current forever","Ignore every government source","Check whether the page is updated and compare with current guidance"],"a":2,"e":"Even reputable sources can become outdated. Check update dates and current recommendations.","t":"Recency","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":65,"q":"A post claims a supplement prevents every cold. What is the best evaluation?","o":["The absolute promise is a red flag; look for evidence for that exact claim","It must work because prevention sounds positive","Try it because it is natural"],"a":0,"e":"Broad promises such as preventing every illness are unlikely to reflect the limits of health evidence.","t":"Overclaiming","s":"NCCIH — Health Information","u":"https://www.nccih.nih.gov/health","d":2},{"id":66,"q":"A friend asks whether to stop prescribed treatment after watching a video. What is the safest reply?","o":["Tell them to stop immediately","Encourage them to discuss concerns with a qualified healthcare professional before changing treatment","Choose a different treatment for them"],"a":1,"e":"Social-media content cannot assess an individual's medical situation. Treatment decisions need qualified care.","t":"Medical decisions","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":67,"q":"You cannot find the original source for a dramatic health statistic. What should you do?","o":["Repeat it with 'maybe'","Assume it came from a study","Do not present it as verified; keep searching or leave it out"],"a":2,"e":"If a statistic cannot be traced to a credible source, it should not be shared as established fact.","t":"Verification","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":68,"q":"A fact-check says a claim is 'missing context.' What does that usually mean?","o":["Some details may be true, but the presentation leaves out information needed to understand them","Every word is necessarily invented","The claim is automatically harmless"],"a":0,"e":"A claim can use true details while omitting context that changes the overall impression.","t":"Context","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":69,"q":"A medical article discusses a treatment for a rare condition. Why should you not assume it applies to a different condition?","o":["All conditions respond the same way","Evidence for one condition does not automatically apply to another","Rare-condition research is never valid"],"a":1,"e":"Evidence is specific to the condition, population, and intervention studied.","t":"Applicability","s":"NCCIH — Clinical Studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":2},{"id":70,"q":"A post says a test is '99% accurate.' What follow-up information matters?","o":["Only the product logo","How many followers the author has","What accuracy means, the population tested, and false-positive and false-negative rates"],"a":2,"e":"A single accuracy figure may hide important details about the test and the population in which it was evaluated.","t":"Diagnostic tests","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":71,"q":"A correction repeats a false claim in a huge headline. What risk can this create?","o":["It may increase familiarity with the false claim if the correction is unclear","It guarantees everyone will reject the claim","It makes evidence unnecessary"],"a":0,"e":"Corrections should clearly state the accurate information and avoid unnecessarily amplifying the falsehood.","t":"Correction design","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":72,"q":"A user uploads a screenshot with no date or account name. What can the tool responsibly say?","o":["It can identify the author with certainty","It can assess the visible claim but should not assume missing context","It can confirm the screenshot is genuine"],"a":1,"e":"A screenshot may omit important context. A tool should distinguish visible content from details it cannot verify.","t":"Screenshot limits","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":73,"q":"A study reports a relative risk reduction. What additional figure helps readers understand the practical effect?","o":["The number of likes","The author's job title","The absolute risk difference"],"a":2,"e":"Absolute risk helps put relative changes into context.","t":"Risk statistics","s":"NCCIH — Health Information","u":"https://www.nccih.nih.gov/health","d":2},{"id":74,"q":"A clinical trial is randomized. What does random assignment help with?","o":["Reducing systematic differences between groups","Guaranteeing there are no limitations","Proving every participant benefits"],"a":0,"e":"Random assignment helps balance known and unknown factors between groups, though it does not remove every limitation.","t":"Randomization","s":"NCCIH — Clinical Studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":2},{"id":75,"q":"A trial is double-blind. What is the main purpose?","o":["To hide all results from the public","To reduce the influence of expectations on participants and researchers","To guarantee the treatment works"],"a":1,"e":"Blinding can reduce certain forms of bias, but it does not guarantee a positive or reliable result.","t":"Blinding","s":"NCCIH — Clinical Studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":2},{"id":76,"q":"A study has a conflict-of-interest disclosure. What should readers do?","o":["Reject it automatically","Ignore the disclosure","Consider the possible influence and assess the methods and evidence"],"a":2,"e":"A disclosure is useful context, not automatic proof that findings are false or true.","t":"Conflicts of interest","s":"NCCIH — Clinical Studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":2},{"id":77,"q":"A health claim is supported by a systematic review. What should you still examine?","o":["The review methods, included studies, and limitations","Only the journal cover","Whether the title sounds certain"],"a":0,"e":"Systematic reviews use structured methods, but their reliability still depends on the evidence and methods.","t":"Systematic reviews","s":"NCCIH — Clinical Studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":2},{"id":78,"q":"A study reports a result with a wide confidence interval. What does that suggest?","o":["The estimate is exact","There is considerable uncertainty about the estimate","The result is guaranteed to be false"],"a":1,"e":"Wide confidence intervals indicate less precision and more uncertainty around an estimate.","t":"Uncertainty","s":"NCCIH — Clinical Studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":2},{"id":79,"q":"A trial excludes people with several common conditions. What is an important limitation?","o":["The results apply to everyone","The exclusions never matter","The findings may not generalize to people who were excluded"],"a":2,"e":"Trial eligibility affects who the results can be generalized to. People unlike participants may need different evidence.","t":"External validity","s":"NCCIH — Clinical Studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":2},{"id":80,"q":"A post compares two treatments but one group started out much healthier. What issue may distort the comparison?","o":["A catchy headline","Baseline differences between groups","The number of emojis"],"a":1,"e":"Differences at the start can affect outcomes and complicate interpretation of comparisons.","t":"Study design","s":"NCCIH — Clinical Studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":2},{"id":81,"q":"A tool finds no reliable source for a claim after searching. What is the most honest output?","o":["Declare the claim false with certainty","Invent a source","Say it could not verify the claim and explain what was checked"],"a":2,"e":"Not finding evidence is not always proof of falsity. A responsible tool reports the limits of its search.","t":"Verification limits","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":82,"q":"A health post is partly correct but omits a major risk. What label is most useful?","o":["Misleading or incomplete, with an explanation of the omitted risk","Completely true","Completely false without explanation"],"a":0,"e":"A nuanced assessment can distinguish accurate elements from missing information that changes the impression.","t":"Nuanced claims","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":83,"q":"A study reports an average benefit. Why might individual outcomes differ?","o":["The average guarantees the same result for everyone","People, conditions, and responses can vary","Averages are never useful"],"a":1,"e":"An average describes a group and does not predict every individual's outcome.","t":"Individual variation","s":"NCCIH — Clinical Studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":2},{"id":84,"q":"A post cites a systematic review, but the review included low-quality studies. What matters?","o":["The title alone","The number of pages","The quality and limitations of the included studies"],"a":2,"e":"A review's conclusions depend partly on the quality of the studies it includes.","t":"Systematic reviews","s":"NCCIH — Clinical Studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":2},{"id":85,"q":"A chart starts its vertical axis at 95 rather than zero. What should a reader examine?","o":["The scale, because it may visually magnify a small difference","Only the chart title","The author's profile picture"],"a":0,"e":"Truncated axes can exaggerate visual differences. Read the scale and underlying values.","t":"Chart literacy","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":86,"q":"A claim is repeated by several websites, all citing the same original unsourced post. What is this?","o":["Independent confirmation from many sources","An echo of one unverified source, not multiple independent confirmations","A clinical consensus"],"a":1,"e":"Many copies of one claim do not create independent evidence. Trace sources back to their origin.","t":"Source tracing","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":87,"q":"An AI checker gives a confidence score of 98%. What should users still be able to inspect?","o":["Nothing; the score is enough","Only the color of the result","The evidence, sources, uncertainty, and explanation behind the assessment"],"a":2,"e":"A confidence score is not a substitute for transparent evidence and a clear explanation.","t":"AI transparency","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":88,"q":"A health claim changes wording each time it is shared. What should a fact-checker do?","o":["Identify the precise version being assessed and trace its source","Treat every version as identical","Choose the easiest wording and ignore the rest"],"a":0,"e":"Fact-checking needs a clearly defined claim; small wording changes can change what is being asserted.","t":"Claim definition","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":89,"q":"A study has a strong design but very few participants and wide confidence intervals. What does that suggest?","o":["The result is perfectly precise","There may be substantial uncertainty around the estimate","The study must be fabricated"],"a":1,"e":"Wide confidence intervals indicate imprecision; the estimate may be compatible with a range of effects.","t":"Uncertainty","s":"NCCIH — Clinical Studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":2},{"id":90,"q":"A post claims a treatment is effective because patients improved after receiving it, with no untreated comparison. What alternative explanation remains?","o":["There can be no alternative explanation","The treatment must have caused every improvement","Patients might have improved for other reasons, including natural recovery or other care"],"a":2,"e":"Without a comparison, improvement cannot automatically be attributed to the treatment.","t":"Causality","s":"NCCIH — Clinical Studies","u":"https://www.nccih.nih.gov/health/clinical-trials-what-are-they","d":2},{"id":91,"q":"An AI system is trained mostly on health content from one region. What risk should its designers evaluate?","o":["It may miss local language, context, and health-system differences elsewhere","It will always be more accurate globally","Training location never matters"],"a":0,"e":"Training data can shape how a system performs across languages and contexts. Testing across groups is important.","t":"AI bias","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":92,"q":"A user asks why a claim was rated misleading. Which response best supports learning?","o":["Because the AI said so","Show which part lacks support, explain the evidence, and link to sources","Give only a red warning icon"],"a":1,"e":"An explanation helps users understand the reasoning and independently verify the evidence.","t":"Explainability","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":93,"q":"A platform flags a claim as potentially misleading before sharing. What should the warning avoid?","o":["Encouraging a pause","Offering a link to evidence","Presenting an uncertain automated flag as a final medical verdict"],"a":2,"e":"Warnings should communicate uncertainty and invite checking, not pretend an automated system is infallible.","t":"Warning design","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":94,"q":"A health intervention has benefits but also known risks. What is the fairest summary?","o":["Describe both benefits and risks with context, rather than calling it completely safe or completely dangerous","Mention only the benefits","Mention only frightening risks"],"a":0,"e":"Balanced risk communication gives readers relevant benefits, harms, and uncertainty in context.","t":"Risk communication","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":95,"q":"A team wants to test whether its misinformation tool improves critical thinking. Which evaluation is strongest?","o":["Ask users whether they liked the colors","Compare performance on new, unseen claims before and after or against a comparison group","Count how many times users opened the app"],"a":1,"e":"Testing unseen claims can show whether users learned transferable evaluation skills, not just memorized answers.","t":"Evaluating interventions","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":96,"q":"After using a quiz, users score higher on the exact questions they practiced. What additional test would best show transfer?","o":["Repeat the same questions immediately","Ask whether they enjoyed the quiz","Give new claims they have not seen and assess their reasoning"],"a":2,"e":"Unseen questions help test whether learning transfers beyond memorized answers.","t":"Learning transfer","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":97,"q":"A platform flags a claim as potentially misleading before sharing. What should the warning avoid?","o":["Encouraging a pause","Offering a link to evidence","Presenting an uncertain automated flag as a final medical verdict"],"a":2,"e":"Warnings should communicate uncertainty and invite checking, not pretend an automated system is infallible.","t":"Warning design","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":98,"q":"A health intervention has benefits but also known risks. What is the fairest summary?","o":["Describe both benefits and risks with context, rather than calling it completely safe or completely dangerous","Mention only the benefits","Mention only frightening risks"],"a":0,"e":"Balanced risk communication gives readers relevant benefits, harms, and uncertainty in context.","t":"Risk communication","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":99,"q":"A team wants to test whether its misinformation tool improves critical thinking. Which evaluation is strongest?","o":["Ask users whether they liked the colors","Compare performance on new, unseen claims before and after or against a comparison group","Count how many times users opened the app"],"a":1,"e":"Testing unseen claims can show whether users learned transferable evaluation skills, not just memorized answers.","t":"Evaluating interventions","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2},{"id":100,"q":"After using a quiz, users score higher on the exact questions they practiced. What additional test would best show transfer?","o":["Repeat the same questions immediately","Ask whether they enjoyed the quiz","Give new claims they have not seen and assess their reasoning"],"a":2,"e":"Unseen questions help test whether learning transfers beyond memorized answers.","t":"Learning transfer","s":"WHO — Health literacy","u":"https://www.who.int/health-topics/health-literacy","d":2}];
const KEY="hm_100q_progress_v6", $=id=>document.getElementById(id);
let soundEnabled=true,audioCtx=null;
function freshProgress(){return{round:1,used:[],points:0,correct:0,roundPoints:0,roundCorrect:0,roundQuestions:[],roundAnswers:{},qIndex:0};}
let progress=freshProgress();
function save(){try{localStorage.setItem(KEY,JSON.stringify(progress));}catch(e){console.warn("Save failed",e);}}
function load(){try{const s=JSON.parse(localStorage.getItem(KEY)||"null");if(!s||!Array.isArray(s.used))return;progress={...freshProgress(),...s};progress.round=Math.max(1,Math.min(26,Number(progress.round)||1));progress.used=[...new Set(progress.used.filter(Number.isInteger).filter(x=>x>=1&&x<=100))];progress.points=Math.max(0,Number(progress.points)||0);progress.correct=Math.max(0,Number(progress.correct)||0);progress.roundQuestions=Array.isArray(progress.roundQuestions)?progress.roundQuestions.filter(q=>q&&QUESTIONS.some(x=>x.id===q.id)):[];progress.roundAnswers=progress.roundAnswers&&typeof progress.roundAnswers==="object"?progress.roundAnswers:{};progress.qIndex=Math.max(0,Math.min(3,Number(progress.qIndex)||0));if(progress.roundQuestions.length!==4){progress.roundQuestions=[];progress.roundAnswers={};progress.qIndex=0;progress.roundPoints=0;progress.roundCorrect=0;}}catch(e){progress=freshProgress();}}
function show(id){document.querySelectorAll(".screen").forEach(x=>x.classList.remove("active"));$(id).classList.add("active");window.scrollTo({top:0,behavior:"smooth"});}
function shuffle(a){a=[...a];for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
const ranks=[{name:"Beginner",icon:"🌱",at:5,desc:"You are building the foundations of health literacy."},{name:"Fact Finder",icon:"🔎",at:10,desc:"You are learning to trace claims back to evidence."},{name:"Critical Thinker",icon:"🧠",at:15,desc:"You can examine research and question misleading claims."},{name:"Misinformation Defender",icon:"🛡️",at:20,desc:"You are learning to pause, verify, and share responsibly."},{name:"Health Guardian",icon:"👑",at:25,desc:"You completed the full health-literacy journey."}];
const medals=["🌱","🔎","🧭","💡","⭐","🔍","🧩","📚","🎯","⭐","💡","⚖️","🧠","🛡️","🌟","🔬","🧭","🧠","🎯","🛡️","🧭","📖","🎯","🛡️","👑"];
const medalNames=["Curious Sprout","Keen Observer","Source Seeker","Question Keeper","Growing Mind","Evidence Explorer","Clue Connector","Knowledge Builder","Claim Detective","Fact Finder Elite","Insight Seeker","Fair Evaluator","Critical Mind","Careful Sharer","Bright Thinker","Evidence Tester","Science Navigator","Logic Leader","Risk Recognizer","Defender Elite","Context Explorer","Research Reader","Precision Thinker","Health Advocate","Supreme Guardian"];
function rankFor(n){return ranks.find(r=>n<=r.at)||ranks[4];}
function renderHome(){let done=progress.round-1;$("journeySummary").textContent=`Completed ${done} of 25 rounds · Current rank: ${rankFor(Math.min(progress.round,25)).name}`;$("homeScore").textContent=`Total score: ${progress.points} pts`;$("begin").textContent=progress.round>25?"View completed journey":done===0?"Start Round 1 →":`Continue Round ${progress.round} →`;$("roundMap").innerHTML=Array.from({length:25},(_,i)=>{let n=i+1;return `<div class="rounddot ${n<=done?"done":n===progress.round?"current":""}">${n<=done?"✓":n===progress.round?"▶":"○"}<br>R${n}</div>`;}).join("");$("milestoneCollection").innerHTML=ranks.map(r=>`<div class="badge" style="opacity:${r.at<=done?1:.48}"><span>${r.at<=done?r.icon:"🔒"}</span><div><b>${r.name}</b><small>Rounds ${r.at-4}–${r.at}</small></div></div>`).join("");$("badgeCollection").innerHTML=medalNames.map((n,i)=>`<div class="badge" style="opacity:${i+1<=done?1:.45}"><span>${i+1<=done?medals[i]:"🔒"}</span><div><b>${i+1<=done?n:"Locked medal"}</b><small>Round ${i+1}</small></div></div>`).join("");}
function startRound(){if(progress.round>25){showComplete();return;}let valid=progress.roundQuestions.length===4&&progress.roundQuestions.every(q=>QUESTIONS.some(x=>x.id===q.id));if(!valid){let pool=shuffle(QUESTIONS.filter(q=>!progress.used.includes(q.id)));if(pool.length<4){showComplete();return;}progress.roundQuestions=pool.slice(0,4);progress.roundAnswers={};progress.qIndex=0;progress.roundCorrect=0;progress.roundPoints=0;save();}show("quizScreen");renderQuestion();}
function renderQuestion(){let q=progress.roundQuestions[progress.qIndex];if(!q){startRound();return;}$("roundLabel").textContent=`ROUND ${progress.round} / 25`;$("qCount").textContent=`Question ${progress.qIndex+1} of 4`;$("topic").textContent=q.t;$("difficulty").textContent=["Easy","Medium","Advanced"][q.d]||"General";$("badgeLabel").textContent=`${rankFor(progress.round).icon} ${rankFor(progress.round).name}`;$("question").textContent=q.q;$("scoreLabel").textContent=`${progress.points} pts`;$("bar").style.width=`${progress.qIndex/4*100}%`;$("feedback").className="feedback";$("feedback").replaceChildren();$("next").classList.add("hidden");$("options").replaceChildren();q.o.forEach((v,i)=>{let b=document.createElement("button");b.type="button";b.className="option";let l=document.createElement("span");l.className="letter";l.textContent=String.fromCharCode(65+i);let t=document.createElement("span");t.textContent=v;b.append(l,t);b.addEventListener("click",()=>answer(i));$("options").append(b);});let chosen=progress.roundAnswers[String(q.id)];if(Number.isInteger(chosen))showAnswerState(q,chosen);}
function showAnswerState(q,c){let good=c===q.a;document.querySelectorAll(".option").forEach((b,i)=>{b.disabled=true;if(i===q.a)b.classList.add("correct");if(i===c&&!good)b.classList.add("wrong");});let box=$("feedback");box.className=`feedback show ${good?"":"bad"}`;let h=document.createElement("h3");h.textContent=good?"✓ Correct!":"Not quite — here's what matters.";let p=document.createElement("p");p.textContent=q.e;let a=document.createElement("a");a.href=q.u;a.target="_blank";a.rel="noopener noreferrer";a.textContent=`↗ ${q.s}`;box.replaceChildren(h,p,a);$("bar").style.width=`${(progress.qIndex+1)/4*100}%`;$("next").textContent=progress.qIndex===3?"Finish round & claim medal →":"Next question →";$("next").classList.remove("hidden");}
function answer(c){let q=progress.roundQuestions[progress.qIndex];if(!q||Number.isInteger(progress.roundAnswers[String(q.id)])||!Number.isInteger(c)||c<0||c>=q.o.length)return;progress.roundAnswers[String(q.id)]=c;progress.used=[...new Set([...progress.used,q.id])];if(c===q.a){progress.roundCorrect++;progress.correct++;progress.roundPoints+=10;progress.points+=10;}save();showAnswerState(q,c);}
function nextQuestion(){if(progress.qIndex<3){progress.qIndex++;save();renderQuestion();}else finishRound();}
function finishRound(){let n=progress.round,c=progress.roundCorrect,pts=progress.roundPoints,pct=Math.round(c/4*100),r=rankFor(n);$("resultMedal").textContent=medals[n-1];$("resultBadgePill").textContent=`Round ${n} Medal: ${medalNames[n-1]}`;$("badgeMotivationText").textContent=r.desc;$("resultTitle").textContent=pct>=75?"Excellent progress!":pct>=50?"You're learning with every round!":"Round complete — keep building skill!";$("resultText").textContent=`You completed Round ${n} and earned ${pts} points.`;$("correctStat").textContent=`${c}/4`;$("pointsStat").textContent=pts;$("accuracyStat").textContent=pct+"%";$("newBadgeArea").textContent=n%5===0?`${r.icon} Rank unlocked: ${r.name}`:"";progress.round++;progress.roundQuestions=[];progress.roundAnswers={};progress.qIndex=0;progress.roundCorrect=0;progress.roundPoints=0;save();$("continue").textContent=progress.round>25?"See final achievement →":`Start Round ${progress.round} →`;show("roundResult");playTone();}
function showComplete(){$("totalPoints").textContent=progress.points;show("journeyDone");playTone(true);}
function resetJourney(){if(!confirm("Start a new journey? Your current quiz progress will be reset."))return;progress=freshProgress();save();renderHome();startRound();}
function initAudio(){try{let AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;if(!audioCtx)audioCtx=new AC();if(audioCtx.state==="suspended")audioCtx.resume();}catch(e){}}
function playTone(grand=false){if(!soundEnabled)return;try{initAudio();if(!audioCtx)return;let ns=grand?[523,659,784,1047]:[523,659,784];ns.forEach((f,i)=>{let o=audioCtx.createOscillator(),g=audioCtx.createGain(),t=audioCtx.currentTime+i*.12;o.type="sine";o.frequency.value=f;g.gain.setValueAtTime(.001,t);g.gain.exponentialRampToValueAtTime(.08,t+.03);g.gain.exponentialRampToValueAtTime(.001,t+.22);o.connect(g);g.connect(audioCtx.destination);o.start(t);o.stop(t+.24);});}catch(e){}}
$("begin").addEventListener("click",()=>{initAudio();progress.round>25?showComplete():startRound();});$("next").addEventListener("click",nextQuestion);$("continue").addEventListener("click",()=>progress.round>25?showComplete():startRound());$("restart").addEventListener("click",resetJourney);$("restartFinal").addEventListener("click",resetJourney);$("soundToggle").addEventListener("click",()=>{soundEnabled=!soundEnabled;$("soundToggle").textContent=soundEnabled?"♫ Sound ON":"♫ Sound OFF";if(soundEnabled)playTone();});
load();renderHome();
</script></body></html>